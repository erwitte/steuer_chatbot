# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your personal Telegram numeric user ID — the only account the bot responds to
ALLOWED_TELEGRAM_USER_ID=

# Credentials for the Postgres container. Must match DATABASE_URL below.
# (Only applied when the database volume is first created.)
POSTGRES_USER=steuer_chatbot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=steuer_chatbot

# Postgres connection string for the metadata DB
DATABASE_URL=postgresql://steuer_chatbot:changeme@db:5432/steuer_chatbot

# Host directory bind-mounted into the bot container for storing receipt photos/PDFs
RECEIPTS_DIR=./data/receipts
